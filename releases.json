    "tracks": "required - number of tracks",
    "spotify": "required unless soundcloud is set - Spotify album URL, the canonical source",
    "soundcloud": "optional - SoundCloud URL on its_nya_music, for a release that is not on Spotify",
    "page": "optional - URL of the release's own page on this site. A row links to page first, then Spotify, then SoundCloud",
    "with": "optional - other main artists on a joint release, each listed under artists",
    "features": "optional - guests on the release, as [{track, title, artists}]: track number, track title, guest names. Each guest must be listed under artists. Structured data only, never shown on the page",
